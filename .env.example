# ==========================================
# AI-Powered Resume Analyzer - Environment Configuration
# ==========================================

# Database Settings:
# - Local SQLite default: sqlite+aiosqlite:///./sql_app.db
# - Free Cloud PostgreSQL (Neon.tech / Supabase.com):
#   DATABASE_URL=postgresql://postgres:yourpassword@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# JWT Authentication Secret Key
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-change-in-production-ai-resume-2026

# AI Integration Keys (Choose one or both for live AI features):
# 1. Free Google Gemini API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI API Key (Optional)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend Base URL (Set in Vercel environment variables if needed)
# VITE_API_URL=/api/v1
